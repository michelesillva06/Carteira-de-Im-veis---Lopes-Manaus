{
  "entities": {
    "users": {
      "title": "User Account",
      "description": "System users including administrators and real estate brokers",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "corretor"] },
        "creci": { "type": "string" },
        "phone": { "type": "string" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastLoginAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "role"]
    },
    "auditLogs": {
      "title": "Audit Log",
      "description": "System security and operational logs",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userRole": { "type": "string" },
        "action": { "type": "string" },
        "details": { "type": "string" },
        "ip": { "type": "string" }
      },
      "required": ["timestamp", "userId", "action"]
    }
  }
}
